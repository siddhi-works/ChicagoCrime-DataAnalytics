  "id": "dq_date_repair",
  "tier": "data_quality",
  "headline": "424,638 dates had month and day swapped by Excel; we repaired them",
  "text": "40% of the Date cells were stored as real datetimes (all with day <= 12), the rest as MM/DD/YYYY text. Excel read the ambiguous ones day-first. Swapping them back makes records dated after their own 'Updated On' stamp fall from 3.3% to 0.0%, and reproduces the handout's monthly chart.",
  "evidence": {
   "text_cells": 623937,
   "excel_datetime_cells_swapped": 424638,
   "unparseable": 0,
   "year_matches_Year_col_after": 1.0,
   "date_after_updated_on_share_before_repair": 0.03296,
   "date_after_updated_on_share_after_repair": 0.0,
   "month_swap_evidence": "Excel-converted cells have day<=12 only and a flat 'month' distribution; text cells have day>=13 only. Ambiguous cells were read day-first by Excel."
  },
  "method": "Compare text vs datetime cells; test day/month distributions; consistency with Updated On.",
  "charts": [
   "q01"
  ],
  "caveat": "The original workbook was not modified; the repair is applied in memory by src/clean.py."
 },
