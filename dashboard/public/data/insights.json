 {
  "id": "arrest_drivers",
  "tier": "headline",
  "headline": "What was reported predicts arrest far better than when or where (AUC 0.86 on unseen later months)",
  "text": "Trained on records before 2017-01-01 (474,279) and tested on later ones (153,508): logistic AUC 0.837, gradient boosting 0.865. Shuffling crime_type costs 0.310 AUC, location 0.100, while time of day plus weekday together cost 0.005. Brier score improves from 0.162 (base rate) to 0.095.",
  "evidence": {
   "train_n": 474279,
   "test_n": 153508,
   "test_from": "2017-01-01",
   "auc_logistic": 0.836538,
   "brier_logistic": 0.103012,
   "brier_baseline": 0.162232,
   "bootstrap_reps": 15,
   "auc_gradient_boosting": 0.864816,
   "brier_gradient_boosting": 0.094833,
